{
  "name": "froebel-academy-teens-profesor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "npm run typecheck && npm run build:site && npm run build:app && npm run build:konva",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && npm run typecheck --workspace @froebel/worker && tsc -p app-live/tsconfig.json",
    "worker:dev": "wrangler dev --local --config worker/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "worker:deploy": "node scripts/deploy-worker.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:engine": "node scripts/test-engine.mjs",
    "build:site": "vite build && node scripts/prepare-static.mjs",
    "build:app": "node scripts/build-app.mjs",
    "test:scaffold": "node --test tests/scaffold.test.mjs",
    "test:e1": "node scripts/test-e1.mjs",
    "test:e2": "npm run typecheck:e2 && vitest run --config vitest.config.ts",
    "typecheck:e2": "tsc -p tests/tsconfig.json",
    "test:e3": "npm run typecheck:e2 && vitest run --config vitest.config.ts tests/e3",
    "test:e4": "npm run test:engine && npm run typecheck:e2 && vitest run --config vitest.config.ts tests/e4",
    "test:e5": "node scripts/test-connection.mjs",
    "test:e6": "node scripts/test-navigation.mjs && npm run test:e5 && npm run test:e2",
    "test:sim": "node scripts/sim.ts",
    "test:e8": "npm run build && npm run test:engine && node scripts/test-navigation.mjs && npm run test:e5 && npm run test:e2 && npm run test:scaffold && npm run test:sim",
    "test:geometry": "node scripts/test-geometry.mjs",
    "test:arithmetic": "node --test tests/arithmetic/*.test.mjs",
    "test:reasoning": "node --test tests/reasoning/*.test.mjs",
    "test:recta": "node scripts/test-recta.mjs",
    "test:e9": "npm run test:e8 && npm run test:geometry",
    "test:equivalence": "node scripts/test-equivalence.mjs",
    "test:e10": "npm run test:e9 && npm run test:equivalence",
    "dev:konva": "vite --config vite.konva.config.ts",
    "build:konva": "node scripts/build-konva.mjs",
    "test:combined": "node --test tests/combined/*.test.mjs",
    "test:algebra": "node --test tests/algebra/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.80.0",
    "dompurify": "3.4.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261113.1",
    "@playwright/test": "1.56.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.6.3",
    "undici": "7.30.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "$wrangler",
      "miniflare": "5.20261019.2-beta"
    }
  },
  "workspaces": [
    "worker",
    "app",
    "app-live"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
