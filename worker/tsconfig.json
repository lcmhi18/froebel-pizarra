{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "baseUrl": "..",
    "paths": {
      "@shared": [
        "src/shared/protocol.ts"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  },
  "include": [
    "*.ts",
    "../src/shared/*.ts"
  ]
}
